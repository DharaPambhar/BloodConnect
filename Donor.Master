<%@ Master Language="C#" AutoEventWireup="true"
    CodeBehind="Donor.master.cs"
    Inherits="WebApplication1.Donor" %>

<!DOCTYPE html>

<html>

<head runat="server">

    <title>BloodConnect</title>

    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background-color: #F8F9FA;
            color: #202338;
        }

        .layout {
            display: flex;
            min-height: 100vh;
        }

        /* SIDEBAR */

        .sidebar {
            width: 250px;
            background-color: white;
            border-right: 1px solid #E5E7EB;
            position: fixed;
            left: 0;
            top: 0;
            bottom: 0;
            padding: 24px 16px;
            overflow-y: auto;
        }

        .logo {
            color: #D80032;
            font-size: 21px;
            font-weight: bold;
            padding: 5px 12px 28px 12px;
        }

        .menu-title {
            color: #9CA3AF;
            font-size: 11px;
            font-weight: bold;
            text-transform: uppercase;
            padding: 0 12px;
            margin-bottom: 10px;
        }

        .menu a {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            color: #4B5563;
            font-size: 13px;
            padding: 11px 12px;
            margin-bottom: 4px;
            border-radius: 7px;
        }

        .menu a:hover {
            background-color: #FFF0F3;
            color: #D80032;
        }

        .menu a.active {
            background-color: #FFF0F3;
            color: #D80032;
            font-weight: bold;
        }

        .icon {
            width: 24px;
            text-align: center;
            font-size: 16px;
        }

        /* LOGOUT */

        .logout {
            border-top: 1px solid #EEEEEE;
            margin-top: 20px;
            padding-top: 15px;
        }

        .logout a {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            color: #6B7280;
            font-size: 13px;
            padding: 11px 12px;
            border-radius: 7px;
        }

        .logout a:hover {
            background-color: #F3F4F6;
            color: #D80032;
        }

        /* MAIN AREA */

        .main-area {
            margin-left: 250px;
            width: calc(100% - 250px);
            min-height: 100vh;
        }

        /* TOP HEADER */

        .top-header {
            height: 72px;
            background-color: white;
            border-bottom: 1px solid #E5E7EB;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 35px;
        }

        .page-title {
            font-size: 21px;
            font-weight: bold;
            color: #202338;
        }

        .header-right {
            display: flex;
            align-items: center;
            gap: 22px;
        }

        .notification {
            text-decoration: none;
            color: #4B5563;
            font-size: 20px;
        }

        .notification:hover {
            color: #D80032;
        }

        /* PROFILE */

        .profile {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .profile-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background-color: #FFF0F3;
            color: #D80032;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 15px;
            font-weight: bold;
        }

        .profile-info {
            line-height: 1.3;
        }

        .profile-name {
            font-size: 13px;
            font-weight: bold;
            color: #1F2937;
        }

        .profile-role {
            font-size: 11px;
            color: #9CA3AF;
        }

        /* CONTENT */

        .content {
            padding: 30px 35px;
            min-height: calc(100vh - 72px);
        }

        /* RESPONSIVE */

        @media (max-width: 900px) {

            .sidebar {
                width: 210px;
            }

            .main-area {
                margin-left: 210px;
                width: calc(100% - 210px);
            }

            .content {
                padding: 25px;
            }

        }

        @media (max-width: 650px) {

            .sidebar {
                width: 70px;
                padding: 20px 8px;
            }

            .logo {
                font-size: 0;
                text-align: center;
                padding: 5px 0 25px 0;
            }

            .logo::after {
                content: "🩸";
                font-size: 24px;
            }

            .menu-title {
                display: none;
            }

            .menu a span:not(.icon),
            .logout a span:not(.icon) {
                display: none;
            }

            .menu a,
            .logout a {
                justify-content: center;
                padding: 12px 5px;
            }

            .main-area {
                margin-left: 70px;
                width: calc(100% - 70px);
            }

            .top-header {
                padding: 0 15px;
            }

            .page-title {
                font-size: 17px;
            }

            .profile-info {
                display: none;
            }

        }

    </style>

</head>


<body>

<form id="form1" runat="server">

    <div class="layout">

        <!-- SIDEBAR -->

        <aside class="sidebar">

            <div class="logo">
                🩸 BloodConnect
            </div>

            <div class="menu-title">
                Donor Menu
            </div>

            <nav class="menu">

                <!-- DONOR DASHBOARD -->

                <a href="DonorDashboard.aspx"
                   class="<%= System.IO.Path.GetFileName(Request.Url.AbsolutePath).Equals("DonorDashboard.aspx", StringComparison.OrdinalIgnoreCase) ? "active" : "" %>">

                    <span class="icon">⌂</span>
                    <span>Donor Dashboard</span>

                </a>


                <!-- DONOR PROFILE -->

                <a href="Donor_profile.aspx"
                   class="<%= System.IO.Path.GetFileName(Request.Url.AbsolutePath).Equals("Donor_profile.aspx", StringComparison.OrdinalIgnoreCase) ? "active" : "" %>">

                    <span class="icon">👤</span>
                    <span>Donor Profile</span>

                </a>


                <!-- EDIT PROFILE -->

                <a href="EditProfile.aspx"
                   class="<%= System.IO.Path.GetFileName(Request.Url.AbsolutePath).Equals("EditProfile.aspx", StringComparison.OrdinalIgnoreCase) ? "active" : "" %>">

                    <span class="icon">✏️</span>
                    <span>Edit Profile</span>

                </a>


                <!-- DONATION ELIGIBILITY -->

                <a href="Donation_Eligibility.aspx"
                   class="<%= System.IO.Path.GetFileName(Request.Url.AbsolutePath).Equals("Donation_Eligibility.aspx", StringComparison.OrdinalIgnoreCase) ? "active" : "" %>">

                    <span class="icon">✓</span>
                    <span>Donation Eligibility</span>

                </a>


                <!-- NEARBY EMERGENCY -->

                <a href="NearbyEmergency.aspx"
                   class="<%= System.IO.Path.GetFileName(Request.Url.AbsolutePath).Equals("NearbyEmergency.aspx", StringComparison.OrdinalIgnoreCase) ? "active" : "" %>">

                    <span class="icon">🚨</span>
                    <span>Nearby Emergency</span>

                </a>


                <!-- EMERGENCY DETAILS -->

                <a href="EmergencyDetails.aspx"
                   class="<%= System.IO.Path.GetFileName(Request.Url.AbsolutePath).Equals("EmergencyDetails.aspx", StringComparison.OrdinalIgnoreCase) ? "active" : "" %>">

                    <span class="icon">📋</span>
                    <span>Emergency Details</span>

                </a>


                <!-- FIND CAMPS -->

                <a href="FindCamps.aspx"
                   class="<%= System.IO.Path.GetFileName(Request.Url.AbsolutePath).Equals("FindCamps.aspx", StringComparison.OrdinalIgnoreCase) ? "active" : "" %>">

                    <span class="icon">🏥</span>
                    <span>Find Camps</span>

                </a>


                <!-- CAMP DETAILS -->

                <a href="CampDetails.aspx"
                   class="<%= System.IO.Path.GetFileName(Request.Url.AbsolutePath).Equals("CampDetails.aspx", StringComparison.OrdinalIgnoreCase) ? "active" : "" %>">

                    <span class="icon">📍</span>
                    <span>Camp Details</span>

                </a>


                <!-- BOOK DONATION SLOT -->

                <a href="BookDonationSlot.aspx"
                   class="<%= System.IO.Path.GetFileName(Request.Url.AbsolutePath).Equals("BookDonationSlot.aspx", StringComparison.OrdinalIgnoreCase) ? "active" : "" %>">

                    <span class="icon">📅</span>
                    <span>Book Donation Slot</span>

                </a>


                <!-- DONATION HISTORY -->

                <a href="DonationHistory.aspx"
                   class="<%= System.IO.Path.GetFileName(Request.Url.AbsolutePath).Equals("DonationHistory.aspx", StringComparison.OrdinalIgnoreCase) ? "active" : "" %>">

                    <span class="icon">🩸</span>
                    <span>Donation History</span>

                </a>


                <!-- DONATION DETAILS -->

                <a href="DonationDetails.aspx"
                   class="<%= System.IO.Path.GetFileName(Request.Url.AbsolutePath).Equals("DonationDetails.aspx", StringComparison.OrdinalIgnoreCase) ? "active" : "" %>">

                    <span class="icon">📄</span>
                    <span>Donation Details</span>

                </a>


                <!-- NOTIFICATIONS -->

                <a href="DonorNotifications.aspx"
                   class="<%= System.IO.Path.GetFileName(Request.Url.AbsolutePath).Equals("DonorNotifications.aspx", StringComparison.OrdinalIgnoreCase) ? "active" : "" %>">

                    <span class="icon">🔔</span>
                    <span>Notifications</span>

                </a>

            </nav>


            <!-- LOGOUT -->

            <div class="logout">

                <a href="Login.aspx">

                    <span class="icon">↪</span>
                    <span>Logout</span>

                </a>

            </div>

        </aside>


        <!-- MAIN AREA -->

        <main class="main-area">

            <!-- TOP HEADER -->

            <header class="top-header">

                <div class="page-title">

                    <%= System.IO.Path.GetFileName(Request.Url.AbsolutePath).Equals("Donor_profile.aspx", StringComparison.OrdinalIgnoreCase) ? "Donor Profile" :
                        System.IO.Path.GetFileName(Request.Url.AbsolutePath).Equals("EditProfile.aspx", StringComparison.OrdinalIgnoreCase) ? "Edit Profile" :
                        System.IO.Path.GetFileName(Request.Url.AbsolutePath).Equals("Donation_Eligibility.aspx", StringComparison.OrdinalIgnoreCase) ? "Donation Eligibility" :
                        System.IO.Path.GetFileName(Request.Url.AbsolutePath).Equals("NearbyEmergency.aspx", StringComparison.OrdinalIgnoreCase) ? "Nearby Emergency" :
                        System.IO.Path.GetFileName(Request.Url.AbsolutePath).Equals("EmergencyDetails.aspx", StringComparison.OrdinalIgnoreCase) ? "Emergency Details" :
                        System.IO.Path.GetFileName(Request.Url.AbsolutePath).Equals("FindCamps.aspx", StringComparison.OrdinalIgnoreCase) ? "Find Camps" :
                        System.IO.Path.GetFileName(Request.Url.AbsolutePath).Equals("CampDetails.aspx", StringComparison.OrdinalIgnoreCase) ? "Camp Details" :
                        System.IO.Path.GetFileName(Request.Url.AbsolutePath).Equals("BookDonationSlot.aspx", StringComparison.OrdinalIgnoreCase) ? "Book Donation Slot" :
                        System.IO.Path.GetFileName(Request.Url.AbsolutePath).Equals("DonationHistory.aspx", StringComparison.OrdinalIgnoreCase) ? "Donation History" :
                        System.IO.Path.GetFileName(Request.Url.AbsolutePath).Equals("DonationDetails.aspx", StringComparison.OrdinalIgnoreCase) ? "Donation Details" :
                        System.IO.Path.GetFileName(Request.Url.AbsolutePath).Equals("DonorNotifications.aspx", StringComparison.OrdinalIgnoreCase) ? "Notifications" :
                        "Donor Dashboard" %>

                </div>


                <!-- HEADER RIGHT -->

                <div class="header-right">

                    <a href="DonorNotifications.aspx"
                       class="notification">

                        🔔

                    </a>


                    <div class="profile">

                        <div class="profile-avatar">
                            R
                        </div>

                        <div class="profile-info">

                            <div class="profile-name">
                                Riya
                            </div>

                            <div class="profile-role">
                                Blood Donor
                            </div>

                        </div>

                    </div>

                </div>

            </header>


            <!-- PAGE CONTENT -->

            <div class="content">

                <asp:ContentPlaceHolder
                    ID="ContentPlaceHolder1"
                    runat="server">
                </asp:ContentPlaceHolder>

            </div>

        </main>

    </div>

</form>

</body>

</html>